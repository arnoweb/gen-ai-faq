#!/usr/bin/env bash
# Hook git : si le push contient des modifications sous docs/, republie
# automatiquement ces fichiers vers le repo public arnoweb/projects-docs
# (voir scripts/sync-docs-to-public.sh). Un échec de sync n'annule jamais
# le push en cours vers origin.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
EMPTY_TREE="4b825dc642cb6eb9a060e54bf8d69288fbee4904"
NULL_SHA="0000000000000000000000000000000000000000"
CHANGED=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$NULL_SHA" ] && continue
  base="$remote_sha"
  [ "$remote_sha" = "$NULL_SHA" ] && base="$EMPTY_TREE"
  if ! git diff --quiet "$base" "$local_sha" -- docs/ 2>/dev/null; then
    CHANGED=1
  fi
done

if [ "$CHANGED" = "1" ]; then
  echo "pre-push: modifications détectées dans docs/, synchronisation vers projects-docs..."
  if ! "$REPO_ROOT/scripts/sync-docs-to-public.sh"; then
    echo "pre-push: ATTENTION, la synchronisation vers projects-docs a échoué (le push vers origin continue)" >&2
  fi
fi

exit 0
